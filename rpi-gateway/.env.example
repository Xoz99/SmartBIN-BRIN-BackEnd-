# ─── MQTT broker (server backend) ───────────────────────────────────────────
MQTT_BROKER_HOST=192.168.1.10
MQTT_BROKER_PORT=1883
MQTT_USERNAME=smartbin
MQTT_PASSWORD=replace-with-password-from-setup-mqtt-auth.sh

# ─── Gateway identity ───────────────────────────────────────────────────────
GATEWAY_ID=rpi-gateway-01
HEARTBEAT_INTERVAL_SEC=60

# ─── HTTP mode (gateway_http.py) ────────────────────────────────────────────
# Dipakai HANYA oleh gateway_http.py (kirim ke backend via HTTP, bukan MQTT).
# BACKEND_URL = alamat server backend Node (tanpa slash akhir).
# DEVICE_INGEST_KEY = HARUS sama dengan DEVICE_INGEST_KEY di .env backend.
BACKEND_URL=http://192.168.1.44:3000
DEVICE_INGEST_KEY=replace-with-DEVICE_INGEST_KEY-from-backend-env
HTTP_TIMEOUT_SEC=10
HTTP_RETRIES=2

# ─── LoRa ───────────────────────────────────────────────────────────────────
# Driver:
#   serial = board LoRa32/TTGO jadi RX, nyolok ke Raspi via USB (baca "SENSOR:...")
#   rfm9x  = chip RFM9x/SX127x langsung di Raspi via SPI
#   mock   = test tanpa hardware LoRa
LORA_DRIVER=serial
LORA_FREQ_MHZ=923.0
# Hanya untuk LORA_DRIVER=serial — cek port board LoRa32: `ls /dev/ttyUSB* /dev/ttyACM*`
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# ─── Camera (optional) ──────────────────────────────────────────────────────
# Leave CAMERA_NODE_ID empty to disable camera capture.
# If set, RPi captures an image every CAMERA_INTERVAL_SEC and publishes it
# under that node's image topic for backend YOLOv5 classification.
CAMERA_NODE_ID=
CAMERA_INTERVAL_SEC=300

# ─── Gateway UNIFIED (gateway_unified.py) ───────────────────────────────────
# Gabungan LoRa + HTTP dalam satu proses di Raspi RX. Node HTTP POST ke Raspi
# ini, lalu Raspi ukur metrik & teruskan ke backend (BACKEND_URL di atas).
#
# HTTP server di Raspi:
GATEWAY_HTTP_ENABLE=1
GATEWAY_HTTP_HOST=0.0.0.0
GATEWAY_HTTP_PORT=8080
# Kunci opsional untuk endpoint HTTP Raspi. Kosong = terbuka (LAN penelitian).
# Kalau diisi, node HTTP wajib kirim header X-Device-Key yang sama.
GATEWAY_INGEST_KEY=
#
# Parameter RF LoRa (untuk hitung airtime → throughput). WAJIB sama dgn firmware TX.
LORA_SF=7
LORA_BW_HZ=125000
LORA_CR_DENOM=5
LORA_PREAMBLE=8
# Catatan: LORA_DRIVER=none → matikan pintu LoRa, gateway jadi HTTP-only.

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
