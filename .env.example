# ================================
# TEMPLATE — copy jadi `.env`, isi nilai asli (JANGAN commit `.env`).
# `.env` sudah di-.gitignore. File ini yang di-track sebagai contoh.
# ================================

# ================================
# App
# ================================
PORT=3000
NODE_ENV=production

# ================================
# Database (PostgreSQL)
# ================================
# Docker Compose prod: host = nama service 'postgres'. Lokal: localhost.
DATABASE_URL="postgresql://smartbin:CHANGE_ME_DB_PASSWORD@localhost:5432/smartbin_db?schema=public"
# Dipakai docker-compose.prod.yml untuk init container Postgres — samakan dgn password di DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ================================
# Redis
# ================================
REDIS_URL="redis://localhost:6379"

# ================================
# MQTT (HiveMQ Cloud)
# ================================
MQTT_BROKER_URL=mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME
# KOSONGKAN → backend pakai ID unik otomatis (smartbin-backend-<timestamp>).
# JANGAN isi nilai tetap yang sama di >1 instance → broker saling tendang (reconnect loop).
MQTT_CLIENT_ID=

# ================================
# Weight mode (pembacaan berat)
# ================================
# sensor_pairing = kamera klasifikasi dulu, berat menyusul, baru deposit.
# accumulate     = berat tong = TOTAL berjalan, tiap penimbangan dijumlah (reset saat pickup).
WEIGHT_MODE=accumulate
# Ambang timbangan kosong (kg). Pakai software tare (POST /bins/:id/tare) → kosong ≈ 0,
# jadi ambang bisa kecil biar barang ringan (daun/plastik) tetap kehitung.
WEIGHT_ZERO_THRESHOLD=0.03

# ================================
# JWT
# ================================
# Generate: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_LONG_RANDOM_SECRET
JWT_EXPIRES_IN="7d"

# ================================
# Python Classify Microservice
# ================================
CLASSIFY_SERVICE_URL="http://localhost:8000"

# ================================
# Device HTTP ingest (gateway/raspi push data via POST /ingest/sensor & /classifications)
# ================================
# Harus SAMA dengan DEVICE_INGEST_KEY di sisi gateway/raspi. Generate: openssl rand -hex 24
DEVICE_INGEST_KEY=CHANGE_ME_GENERATE_RANDOM_KEY

# ================================
# CORS — URL frontend
# ================================
CORS_ORIGIN=https://frontend-smartbin-brin.vercel.app

# ================================
# Rate limit login (0 = matikan, mis. saat di belakang proxy)
# ================================
AUTH_RATE_LIMIT_MAX=0

# ================================
# Bind alamat backend (dipakai docker-compose.prod.yml).
# Isi IP Tailscale VPS untuk akses dari jaringan yang blokir IP publik,
# atau 0.0.0.0 untuk semua interface.
# ================================
BACKEND_TS_BIND=0.0.0.0

# ================================
# Firebase FCM (opsional — push otomatis nonaktif bila file tidak ada)
# ================================
FIREBASE_CREDENTIALS_PATH="./firebase-credentials.json"

# ================================
# Thresholds (default, bisa dioverride per-bin)
# ================================
DEFAULT_WEIGHT_THRESHOLD=45
DEFAULT_VOLUME_THRESHOLD=85
DEFAULT_BATTERY_THRESHOLD=20
DEFAULT_GAS_THRESHOLD=300

# Ambang CRITICAL (dokumentasi hardware EcoSort §6 & §8)
VOLUME_CRITICAL_THRESHOLD=100
BATTERY_VOLTAGE_WARNING=10.2
BATTERY_VOLTAGE_CRITICAL=9.6
BATTERY_VOLTAGE_RECOVERY=10.5
# Tidak ada pesan sensor selama N detik → tong ditandai offline
BIN_OFFLINE_GAP_SEC=30
