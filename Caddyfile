# Backend SmartBIN di root domain smartbin.sbs.
# Site ada DI BELAKANG Cloudflare (proxy). Sertifikat pakai Cloudflare Origin
# Certificate (valid 15 tahun) — BUKAN Let's Encrypt lagi, biar gak gagal
# perpanjang di belakang proxy Cloudflare. File cert di-mount di /etc/caddy/certs
# (lihat volume `./certs` di docker-compose.prod.yml). Cloudflare SSL mode: Full (strict).
# reverse_proxy otomatis dukung WebSocket (wss://) juga.

smartbin.sbs {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	# Inference kamera admin (EfficientNet TFLite) → service predict.
	handle /predict* {
		reverse_proxy predict:9000
	}
	# Sisanya → backend Node.
	handle {
		reverse_proxy backend:3000
	}
}

# (opsional) redirect www → root
www.smartbin.sbs {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	redir https://smartbin.sbs{uri}
}
