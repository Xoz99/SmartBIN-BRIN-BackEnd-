# Backend SmartBIN di root domain smartbin.sbs.
# Caddy otomatis ambil sertifikat HTTPS Let's Encrypt (GRATIS) —
# syarat: DNS smartbin.sbs sudah nunjuk ke IP VPS + port 80/443 terbuka.
# reverse_proxy otomatis dukung WebSocket (wss://) juga.

smartbin.sbs {
	# Inference kamera admin (EfficientNet TFLite) → service predict.
	handle /predict* {
		reverse_proxy predict:9000
	}
	# Sisanya → backend Node.
	handle {
		reverse_proxy backend:3000
	}
}

# (opsional) redirect www → root
www.smartbin.sbs {
	redir https://smartbin.sbs{uri}
}
