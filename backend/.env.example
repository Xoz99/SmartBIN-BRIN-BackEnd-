# Config Raspi TX (main.py). Copy jadi `.env` di folder ~/backend, lalu cukup:
#   python3 main.py
# (main.py auto-baca file ini via python-dotenv)

# --- Backend tujuan jalur HTTP ---
# Dari WiFi kost yang blokir IP publik VPS → pakai IP TAILSCALE VPS (bukan smartbin.sbs).
# Kalau jaringan bisa jangkau publik, boleh https://smartbin.sbs.
BACKEND_HTTP_URL=http://100.82.171.105:3000
DEVICE_INGEST_KEY=4cc3a6eb99c5bb859b5006b0d23d8f0bd41294953371d543

# --- Jalur forward ---
COMPARE_HTTP=1        # POST sensor langsung ke server (transport=http)
FORWARD_MQTT=0        # 0 saat eksperimen (biar tak dobel via HiveMQ); 1 kalau butuh MQTT
FORWARD_LORA=1        # kirim ke modul LoRa TX

# --- Node & serial (auto-detect kalau dikosongkan) ---
NODE_ID=bin-003
# STM32_PORT=/dev/ttyACM1     # isi kalau auto-detect meleset
# LORA_PORT=/dev/ttyACM0

# --- Kamera monitor ---
CAMERA_PUSH=1
CAMERA_PUSH_SEC=1.5
# AUTO_START_CAM=1

# --- MQTT (HiveMQ) — dipakai buat lapor klasifikasi ---
# MQTT_HOST=4b1ed76fd60640648c995b6c90f11829.s1.eu.hivemq.cloud
# GEMINI_API_KEY=            # opsional (tips AI)
