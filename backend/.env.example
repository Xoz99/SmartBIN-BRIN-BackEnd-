# Config Raspi TX (main.py). Copy jadi `.env` di folder ~/backend, lalu cukup:
#   python3 main.py
# (main.py auto-baca file ini via python-dotenv)

# --- Backend tujuan jalur HTTP ---
# Dari WiFi kost yang blokir IP publik VPS → pakai IP TAILSCALE VPS (bukan smartbin.sbs).
# Kalau jaringan bisa jangkau publik, boleh https://smartbin.sbs.
BACKEND_HTTP_URL=http://100.82.171.105:3000
DEVICE_INGEST_KEY=4cc3a6eb99c5bb859b5006b0d23d8f0bd41294953371d543

# --- Jalur forward ---
COMPARE_HTTP=1        # POST sensor langsung ke server (transport=http)
FORWARD_MQTT=0        # 0 saat eksperimen (biar tak dobel via HiveMQ); 1 kalau butuh MQTT

# --- Node & serial (auto-detect kalau dikosongkan) ---
NODE_ID=bin-003
# STM32_PORT=/dev/ttyACM0     # isi kalau auto-detect meleset

# --- Kamera: monitor (push feed ke dashboard) ---
CAMERA_PUSH=1               # push frame ke backend buat monitor di FE
CAMERA_PUSH_SEC=1.5         # interval push (detik)
CAMERA_JPEG_Q=70            # kualitas JPEG push (1-100)
# CAMERA_INDEX=0            # index kamera (0 = default)
# AUTO_START_CAM=1          # auto nyalain kamera saat start

# --- Kamera: DETEKSI objek di platform (mode PLATFORM) ---
# Deteksi via beda gambar dari kondisi KOSONG (baseline) di area ROI (buletan).
ROI_FRAC=0.6               # fraksi tengah frame = area deteksi (buletan). 0.5 kecil / 0.75 lebar
OBJECT_DIFF=18            # beda dari kosong utk dianggap ADA objek. Naikin kalau kosong ke-trigger sendiri; turunin kalau objek nggak kedeteksi
CLEAR_DIFF=9             # beda di bawah ini = platform kosong lagi
STILL_MOVE=4            # gerak antar-frame di bawah ini = objek diam
STILL_NEED=3           # butuh N frame diam sebelum jepret
SETTLE_DELAY=0.6      # detik tunggu objek diam sebelum jepret (kalau motion-gate)
CONF_THRESHOLD=0    # 0 = tanpa batas (tiap objek langsung diproses). Naikin (mis 0.5) kalau mau selektif

# --- AKTUATOR: durasi tiap kategori (DETIK) ← UKUR PAKAI STOPWATCH, isi di sini ---
# Waktu dari command → sampah jatuh + mekanik balik siap. Habis aktuasi, kamera nunggu
# (ACTUATOR_SEC_<kategori> + REARM_BUFFER) baru siap objek berikutnya.
# Ukur per kategori (jalanin kalibrasi), lalu ganti angka di bawah:
ACTUATOR_SEC_ORGANIK=7      # ← isi hasil ukur (mis. 5)
ACTUATOR_SEC_ANORGANIK=8    # ← isi hasil ukur
ACTUATOR_SEC_B3=9.5         # ← isi hasil ukur
ACTUATOR_SEC_DEFAULT=10     # fallback kalau kategori tak dikenal
REARM_BUFFER=1.5           # jeda ekstra setelah aktuator sebelum siap objek baru

# --- Kamera: debug & kumpul dataset (opsional) ---
SAVE_SHOT=1                # simpan frame yg diklasifikasi ke last_shot.jpg
# DATASET_CAPTURE=1        # 1 = simpan tiap objek ke dataset/<DATASET_LABEL>/ (buat retrain)
# DATASET_LABEL=anorganik  # jenis yg lagi ditaruh (organik/anorganik/b3)

# --- Log ---
LOG_SENSOR_EVERY=1         # cetak ringkasan sensor tiap N bacaan (5/10 = lebih sepi)
LOG_RAW_SERIAL=1           # cetak baris MENTAH dari STM32 apa adanya ([STM32 raw] ...). 0 = matikan biar sepi
IDLE_LOG_SEC=15            # interval log "[CAM] menunggu objek" saat platform kosong (biar keliatan hidup, tak spam)

# --- MQTT (HiveMQ) — dipakai buat lapor klasifikasi ---
# MQTT_HOST=4b1ed76fd60640648c995b6c90f11829.s1.eu.hivemq.cloud
# GEMINI_API_KEY=            # opsional (tips AI)
